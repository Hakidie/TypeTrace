NODE_ENV=development
PORT=5003
MONGO_URI=mongodb://localhost:27017/mern_auth_base
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limits see real client IPs.
TRUST_PROXY=0
# Leave SMTP_HOST empty in development: emails (OTP codes) are printed to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@example.com
OTP_EXPIRES_MINUTES=10
RESET_TOKEN_EXPIRES_MINUTES=15

# Optional. Without these, avatar upload answers 503 and everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. AI chat bot (Gemini). Get a key at https://aistudio.google.com/apikey
# Without a key, /api/chat answers 503 and everything else works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. "Login with Google": OAuth client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Without it, POST /api/auth/google answers 503 and the button is hidden. Use the same ID as VITE_GOOGLE_CLIENT_ID in FE/.env.
GOOGLE_CLIENT_ID=

# Optional. VNPay payment gateway. Sandbox values come from the "Thong tin tich hop cho Merchant" email.
# Without them, payments answer 503 and everything else works.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Optional. MoMo payment gateway, next to VNPay. Sandbox keys: https://developers.momo.vn
# Without the three keys, MoMo payments answer 503. MOMO_IPN_URL is the public address of POST /api/payments/momo/ipn
# (MoMo's server calls it: use ngrok in development; it defaults to http://localhost:<PORT>/api/payments/momo/ipn).
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=
# Development only: true makes the MoMo button pay at once without calling MoMo (refused when NODE_ENV=production).
MOMO_MOCK=false

# Optional. payOS payment gateway, next to VNPay and MoMo. Keys: https://my.payos.vn (Payment channel > Client ID, API Key, Checksum Key).
# Without the three keys, payOS payments answer 503. Register the webhook in payOS (public address of POST /api/payments/payos/webhook:
# use ngrok in development); the return page also asks payOS for the status, so the payment works locally without the webhook.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_URL=https://api-merchant.payos.vn
